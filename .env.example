# Copy this to .env for persistent local development. Keep .env out of version control.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only: required for public intake, scheduled delivery and Back Office invitations. Never put this in VITE_* variables.
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:5173
DEMO_MODE=false

# Optional provider adapters. Configure verified sending domain and consent policy before enabling sequences.
AI_PROVIDER_CODE=openai-compatible
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=your_openai_api_key
RESEND_API_KEY=
RESEND_FROM_EMAIL=
MAX_ACTION_ATTEMPTS=5
MAX_SEQUENCE_STEPS=20

# To review the temporary demo without Supabase, use DEMO_MODE=true and omit the Supabase values.
