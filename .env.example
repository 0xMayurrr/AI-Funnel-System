# ==============================================================================
# BUILDICY: AI LEAD RECOVERY & BOOKING PLATFORM — PRODUCTION CONFIGURATION
# ==============================================================================
# Instructions:
# - To run in DEMO MODE with realistic seed memory: set DEMO_MODE=true
# - To run in FULL PRODUCTION MODE with live databases and real APIs:
#   set DEMO_MODE=false and fill in your actual credentials below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DATABASE (Supabase)
# ------------------------------------------------------------------------------
APP_ORIGIN=http://localhost:5173
DEMO_MODE=false

# Supabase Project URL & Anonymous Public Key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (SERVER ONLY — NEVER expose to client/Vite)
# Required for RLS-bypassing webhooks, scheduled cron actions, and Back Office administration
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. AI REVENUE RECOVERY & QUALIFICATION ENGINE
# ------------------------------------------------------------------------------
# Compatible with OpenAI (GPT-4o / GPT-4o-mini), Azure OpenAI, Anthropic via proxy, or vLLM/Ollama
AI_PROVIDER_CODE=openai-compatible
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=sk-your-openai-or-compatible-api-key

# ------------------------------------------------------------------------------
# 3. META WHATSAPP BUSINESS CLOUD API (Official WhatsApp Integration)
# ------------------------------------------------------------------------------
# Obtain from Meta for Developers -> WhatsApp -> API Setup
META_WHATSAPP_TOKEN=your-meta-whatsapp-system-user-access-token
META_WHATSAPP_PHONE_ID=your-meta-whatsapp-phone-number-id
META_WHATSAPP_APP_SECRET=your-meta-app-secret
# Webhook verification token configured in Meta App Dashboard -> Webhooks
WHATSAPP_VERIFY_TOKEN=buildicy_meta_verify_2026

# ------------------------------------------------------------------------------
# 4. REVENUE RECOVERY CRM LAYER (Google Sheets, HubSpot, Zoho, Webhooks)
# ------------------------------------------------------------------------------
# Buildicy syncs recovered leads and scheduled appointments to client CRMs.
# Simply populate the credentials for the client's CRM:

# HubSpot CRM: Private App Access Token with `crm.objects.contacts.write` scope
HUBSPOT_ACCESS_TOKEN=pat-na1-your-hubspot-access-token

# Google Sheets: Webhook URL from Google Apps Script or Zapier/Make Webhook to append rows
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your-apps-script-id/exec

# Zoho CRM: OAuth Bearer Token / API Token
ZOHO_ACCESS_TOKEN=

# Generic Webhook: Custom Agency Webhook, LeadSquared, Sell.do, or Zapier/n8n
CRM_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (Resend)
# ------------------------------------------------------------------------------
# Used for appointment confirmations, tour calendar invites, and agent alerts
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=concierge@yourbrokerage.com

# ------------------------------------------------------------------------------
# 6. SCHEDULER & WORKFLOW LIMITS
# ------------------------------------------------------------------------------
MAX_ACTION_ATTEMPTS=5
MAX_SEQUENCE_STEPS=20
