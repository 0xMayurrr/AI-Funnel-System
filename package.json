{
  "name": "buildicy-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch worker/src/index.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "node --env-file-if-exists=.env --import tsx worker/src/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.1",
    "@tanstack/react-query": "^5.87.1",
    "hono": "^4.9.8",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
